---
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';
import ListItemCard from '../components/ListItemCard.astro';

const posts = await getCollection('help', ({ data }) => {
  return data.draft !== true;
});

---
<MainLayout title="でんでんの飼育小屋">
  <div class="text-3xl font-bold tracking-tight text-white-900">
    ヘルプデスク 📰
  </div>

  <br>

  <ul class="space-y-3">
      {posts
        .sort((a, b) => b.data.helpPubDate.getTime() - a.data.helpPubDate.getTime())
        .map(post => (
          <ListItemCard
            basePath="help"
            slug={post.slug}
            title={post.data.title}
            pubDate={post.data.helpPubDate}
          />
        ))}
    </ul>

</MainLayout>