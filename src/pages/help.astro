---
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';

const posts = await getCollection('help', ({ data }) => {
  return data.draft !== true;
});

---
<MainLayout title="でんでんの飼育小屋">
  <h1>でんでんのヘルプデスク</h1>
  <ul>
    {posts
      .sort((a, b) => b.data.helpPubDate.getTime() - a.data.helpPubDate.getTime())
      .map(post => (
        <li key={post.slug}>
          <a href={`/help/${post.slug}`}>{post.data.title}</a>
          <span>({
            new Date(post.data.helpPubDate.getTime() + 9 * 60 * 60 * 1000)
            .toISOString().slice(0, 10).replace(/-/g, '/')
          })</span>
        </li>
      ))}
  </ul>
</MainLayout>