---
import { getCollection } from 'astro:content';
import MainLayout from '../../../layouts/MainLayout.astro';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  
  // 重複のないカテゴリリストを作成
  const uniqueCategories = [...new Set(allPosts.map((post) => post.data.category))];

  // カテゴリごとにパスを生成
  return uniqueCategories.map((category) => {
    const filteredPosts = allPosts.filter((post) => post.data.category === category);
    return {
      params: { category },
      props: { posts: filteredPosts },
    };
  });
}

const { category } = Astro.params;
const { posts } = Astro.props;
---

<MainLayout title={`${category}の記事一覧`}>
  <h1>「{category}」カテゴリの記事</h1>
  <ul>
    {posts.map(post => (
      <li>
        <a href={`/blog/${post.slug}`}>{post.data.title}</a>
        <span>({post.data.pubDate.toLocaleDateString()})</span>
      </li>
    ))}
  </ul>
</MainLayout>