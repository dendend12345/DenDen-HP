---
import MainLayout from '../layouts/MainLayout.astro';
import { ViewTransitions } from 'astro:transitions';
---
<MainLayout title="でんでんの飼育小屋">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <ViewTransitions />
  </head>
  <body>

    <div class="image-container">
      <img src="/images/denden_trans.png" alt="でんでん" class="animation-denden-logo"/>
      <img src="/images/logo.png" alt="でんでんロゴ" class="logo-img"/>   
      <div class="text-container">
        <h1 class="official-site-text">ー OFFICIAL SITE ー</h1>
    </div>

    <style>

      @import url('https://fonts.googleapis.com/earlyaccess/notosansjapanese.css');

      .image-container {
        position: relative;
        width: 100%;
        max-width: 1000px;
        margin: 0 auto;
      }
        
      .logo-img {
        width: 100%;
        height: auto;
        display: block;
      }

      .animation-denden-logo {
        position: absolute;
        bottom: -25%;
        left: 10%;
        width: 35%;
        z-index: 2;
        animation: slideIn 0.8s ease forwards;
      }

      @keyframes slideIn {
        from {
          opacity: 0;
          transform: translateX(50px);
        } 
        to {
          opacity: 1;
          transform: translateX(0);
        }
      }

      .official-site-text {
        position: absolute;
        bottom: -10%;
        right: -2%;
        font-family: "Noto Sans Japanese", sans-serif;
        font-weight: 800;
        font-size: 3.2vw;
        color: #FFFFFF;
        z-index: 3;
        white-space: nowrap;
      }

      @media (max-width: 768px) {
        .official-site-text {
          font-size: 1rem;
          bottom: 2%;
          right: 2%;
        }
      }
    </style>

  </body>

</MainLayout>