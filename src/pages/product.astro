---
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';
import ListItemCard from '../components/ListItemCard.astro';

const posts = await getCollection('product', ({ data }) => {
  return data.draft !== true;
});

---
<MainLayout title="でんでんの飼育小屋">

  <div class="text-3xl font-bold tracking-tight text-white-900">
    PRODUCT 📦
  </div>

  <br>

  <ul class="space-y-3">
  {posts
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
    .map(post => (
      <ListItemCard
        basePath="product"
        slug={post.id}
        title={post.data.title}
        pubDate={post.data.date}
        suffix="最終更新"
      />
    ))}
</ul>
  
 
</MainLayout>