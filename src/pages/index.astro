---
import MainLayout from '../layouts/MainLayout.astro';
import { ViewTransitions } from 'astro:transitions';
---
<MainLayout title="でんでんの飼育小屋">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <ViewTransitions />
  </head>
  <body>

    <div class="image-container">
      <img src="/images/denden_trans.png" alt="でんでん" class="animation-denden-logo"/>
      <img src="/images/logo.png" alt="でんでんロゴ" class="logo-img"/>   
      <div class="text-container">
        <h1 class="official-site-text">
          ー OFFICIAL SITE ー
        </h1>
      </div>
    </div>
 
    <div class="text-5xl font-bold tracking-tight text-white-900 text-center my-20">
      ここはでんでんの飼育小屋です。<br>
      でんでんのポートフォリオや日々の活動を紹介しています。
    </div>

    <style is:global>

      @import url('https://fonts.googleapis.com/earlyaccess/notosansjapanese.css');

      .image-container {
        position: relative;
        width: 100%;
        max-width: 1000px;
        margin: 0 auto;
        top: -100px;
      }
        
      .logo-img {
        width: 100%;
        height: auto;
        display: block;
      }

      .animation-denden-logo {
        position: absolute;
        bottom: -25%;
        left: 10%;
        width: 35%;
        z-index: 2;
        animation: slideIn 0.8s ease forwards;
      }

      @keyframes slideIn {
        from {
          opacity: 0;
          transform: translateX(50px);
        } 
        to {
          opacity: 1;
          transform: translateX(0);
        }
      }

      .official-site-text {
        position: absolute;
        /* bottom: -10%; */
        right: -2%;
        font-family: "Noto Sans Japanese", sans-serif;
        font-weight: 800;
        font-size: 3.2vw;
        color: #FFFFFF;
        z-index: 3;
        white-space: nowrap;
      }

      .official-site-text  {
        animation: bounceIn 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
      }

      @keyframes bounceIn {
        0% {
          transform: scale(0);
          opacity: 0;
        }
        60% {
          transform: scale(1.1);
          opacity: 1;
        }
        100% {
          transform: scale(1);
          opacity: 1;
        }
      }

      @media (max-width: 768px) {

        .text-5xl {
          font-size: 0.7rem;
          margin: -40% 0;
        }

        .image-container{
          width: 100%;
          max-width: 100%;
          margin: 30%  auto;
        }

        .official-site-text {
          font-size: 1rem;
          right: 2%;
          top: 98%;
        }
        
        /* .explanation {
          font-size: 0.1rem;
          margin: 100px 0;
        } */

      }
    </style>

  </body>

</MainLayout>