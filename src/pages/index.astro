---
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';

const newsposts = await getCollection('news');
const blogPosts = await getCollection('blog');

---
<MainLayout title="でんでんの飼育小屋">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  </head>
  <h1>HOME</h1>
  <p>ここはでんでんの飼育小屋です。でんでんのポートフォリオや日々の活動を紹介しています。</p>
  <h3>新着お知らせ</h3>
  <ul>
    {newsposts.map(post => (
      <li>
        <a href={`/news/${post.slug}`}>{post.data.title}</a>
        <span>({
          new Date(post.data.date.getTime() + 9 * 60 * 60 * 1000)
          .toISOString().slice(0, 10).replace(/-/g, '/')
        })</span>
      </li>
    ))}
  </ul>
  <h3>新着ブログ</h3>
  <ul>
    {blogPosts
      .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
      .map(post => (
        <li key={post.slug}> {}
          <a href={`/blog/${post.slug}`}>{post.data.title}</a>
          <span>({
            new Date(post.data.pubDate.getTime() + 9 * 60 * 60 * 1000)
            .toISOString().slice(0, 10).replace(/-/g, '/')
          })</span>
        </li>
      ))}
  </ul>
</MainLayout>

<style is:global>
body {
  background-image: url('/images/denden_header2.png');
  background-attachment: fixed;
  background-size: auto;
  background-repeat: no-repeat;
  background-position: bottom right;
}

@media (max-width: 768px) {
  body {
    padding: 1rem;
    background-size: contain;
    background-position: bottom center;
  }
  nav {
    flex-direction: column;
    gap: 0.5rem;
  }
  main {
    padding: 1rem;
  }
}
</style>
