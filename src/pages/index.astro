---

import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';
import ListItemCard from '../components/ListItemCard.astro';
import { ViewTransitions } from 'astro:transitions';

const newsposts = await getCollection('news', ({ data }) => {
  return data.draft !== true;
});

const blogposts = await getCollection('blog', ({ data }) => {
  return data.draft !== true;
});

const helpPosts = await getCollection('help', ({ data }) => {
  return data.draft !== true;
});

---

<MainLayout title="でんでんの飼育小屋">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <ViewTransitions />
  </head>
  <body>

    <div class="image-container">
      <img src="/images/denden_trans.png" alt="でんでん" class="animation-denden-logo"/>
      <img src="/images/logo.png" alt="でんでんロゴ" class="logo-img"/>   
      <div class="text-container">
        <h1 class="official-site-text">
          ー OFFICIAL SITE ー
        </h1>
      </div>
    </div>
 
    <div class="text-5xl font-bold tracking-tight text-white-900 text-center my-20">
      ここはでんでんの飼育小屋です。<br>
      でんでんのポートフォリオや日々の活動を紹介しています。
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 w-full">
      <div>

        <div class="flex items-center gap-3 mb-4">
          <span class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-white-900 whitespace-nowrap">
            新着NEWS
          </span>
          <a href="http://dendend12345.com/news/" class="btn-more shrink-0">
            <span>MORE</span>
            <svg class="btn-more-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>

        <ul class="space-y-3">
          {newsposts
            .slice(0, 2)
            .map(post => (
              <ListItemCard
                basePath="news"
                slug={post.slug}
                title={post.data.title}
                pubDate={post.data.date}
              />
          ))}
        </ul>
      </div>

      <div>
        <div class="flex items-center gap-3 mb-4">
          <span class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-white-900 whitespace-nowrap">
            新着ブログ
          </span>
          <a href="http://dendend12345.com/blog/" class="btn-more shrink-0">
            <span>MORE</span>
            <svg class="btn-more-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>

        <ul class="space-y-3">
          {blogposts
            .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
            .slice(0, 2)
            .map(post => (
              <ListItemCard
                basePath="blog"
                slug={post.slug}
                title={post.data.title}
                pubDate={post.data.pubDate}
              />
            ))}
        </ul>
      </div>

      <div>
        <div class="flex items-center gap-3 mb-4">
          <span class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-white-900 whitespace-nowrap">
            新着ヘルプ
          </span>
          <a href="http://dendend12345.com/help/" class="btn-more shrink-0">
            <span>MORE</span>
            <svg class="btn-more-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>

        <ul class="space-y-3">
          {helpPosts
            .slice(0, 2)
            .sort((a, b) => b.data.helpPubDate.getTime() - a.data.helpPubDate.getTime())
            .map(post => (
              <ListItemCard
                basePath="help"
                slug={post.slug}
                title={post.data.title}
                pubDate={post.data.helpPubDate}
              />
            ))}
        </ul>
      </div>
    </div>

    <style is:global>

      @import url('https://fonts.googleapis.com/earlyaccess/notosansjapanese.css');

      .image-container {
        position: relative;
        width: 100%;
        max-width: 1000px;
        margin: 0 auto;
        top: -100px;
      }
        
      .logo-img {
        width: 100%;
        height: auto;
        display: block;
      }

      .animation-denden-logo {
        position: absolute;
        bottom: -25%;
        left: 10%;
        width: 35%;
        z-index: 2;
        animation: slideIn 0.8s ease forwards;
      }

      @keyframes slideIn {
        from {
          opacity: 0;
          transform: translateX(50px);
        } 
        to {
          opacity: 1;
          transform: translateX(0);
        }
      }

      .official-site-text {
        position: absolute;
        bottom: 0%;
        right: -2%;
        font-family: "Noto Sans Japanese", sans-serif;
        font-weight: 800;
        font-size: 3.2vw;
        color: #FFFFFF;
        z-index: 3;
        white-space: nowrap;
      }

      .official-site-text  {
        animation: bounceIn 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
      }

      @keyframes bounceIn {
        0% {
          transform: scale(0);
          opacity: 0;
        }
        60% {
          transform: scale(1.1);
          opacity: 1;
        }
        100% {
          transform: scale(1);
          opacity: 1;
        }
      }

      .btn-more {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem; /* gap-1.5 */
        padding: 0.25rem 0.75rem; /* px-3 py-1 */
        font-size: 1.25em; /* text-xs */
        font-weight: 600; /* font-semibold */
        color: #4ade80; /* text-green-400 */
        background-color: #171717; /* bg-neutral-900 */
        border: 1px solid rgba(64, 64, 64, 0.6); /* border-neutral-700/60 */
        border-radius: 9999px; /* rounded-full */
        transition: all 0.2s ease;
        text-decoration: none;
      }

      .btn-more:hover {
        background-color: #262626; /* hover:bg-neutral-800 */
        border-color: #4ade80; /* hover:border-green-400 */
        box-shadow: 0 0 10px rgba(74, 222, 128, 0.2);
      }

      .btn-more:hover .btn-more-icon {
        transform: translateX(2px);
      }

      .btn-more-icon {
        width: 0.875rem;
        height: 0.875rem;
        transition: transform 0.2s ease;
      }

      @media (max-width: 768px) {

        .text-5xl {
          font-size: 0.725rem;
          margin-top: 50px;
          margin-bottom: 30px;
          line-height: 1.6;
          }

        .image-container{
          width: 100%;
          max-width: 100%;
          margin: 0 auto 20px auto; 
          top: 0;
        }

        .official-site-text {
          font-size: 4.5vw;
          right: 2%;
          bottom: -5%;
        }
      }

      .text-3xl {
        font-size: 1rem;
      }

      .link{
        font-size: 1rem;
      }

    </style>

  </body>

</MainLayout>