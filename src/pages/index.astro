---

import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';
import ListItemCard from '../components/ListItemCard.astro';
import Footer from '../components/Footer.astro';
import { ViewTransitions } from 'astro:transitions';

const newsposts = await getCollection('news', ({ data }) => {
  return data.draft !== true;
});

const blogposts = await getCollection('blog', ({ data }) => {
  return data.draft !== true;
});

const helpPosts = await getCollection('help', ({ data }) => {
  return data.draft !== true;
});

---

<MainLayout title="でんでんの飼育小屋">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <ViewTransitions />
  </head>
  <body>

    <div class="image-container">
      <img src="/images/denden_trans.png" alt="でんでん" class="animation-denden-logo"/>
      <img src="/images/logo.png" alt="でんでんロゴ" class="logo-img"/>   
      <div class="text-container">
        <h1 class="official-site-text">
          ー OFFICIAL SITE ー
        </h1>
      </div>
    </div>
 
    <div class="text-5xl font-bold tracking-tight text-white-900 text-center my-20">
      ここはでんでんの飼育小屋です。<br>
      でんでんのポートフォリオや日々の活動を紹介しています。
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 w-full">
      <div>

        <div class="flex items-center gap-3 mb-4">
          <span class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-white-900 whitespace-nowrap">
            新着NEWS
          </span>
          <a href="http://dendend12345.com/news/" class="btn-more shrink-0">
            <span>MORE</span>
            <svg class="btn-more-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>

        <ul class="space-y-3">
          {newsposts
            .slice(0, 2)
            .map(post => (
              <ListItemCard
                basePath="news"
                slug={post.slug}
                title={post.data.title}
                pubDate={post.data.date}
              />
          ))}
        </ul>
      </div>

      <div>
        <div class="flex items-center gap-3 mb-4">
          <span class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-white-900 whitespace-nowrap">
            新着ブログ
          </span>
          <a href="http://dendend12345.com/blog/" class="btn-more shrink-0">
            <span>MORE</span>
            <svg class="btn-more-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>

        <ul class="space-y-3">
          {blogposts
            .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
            .slice(0, 2)
            .map(post => (
              <ListItemCard
                basePath="blog"
                slug={post.slug}
                title={post.data.title}
                pubDate={post.data.pubDate}
              />
            ))}
        </ul>
      </div>

      <div>
        <div class="flex items-center gap-3 mb-4">
          <span class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-white-900 whitespace-nowrap">
            新着ヘルプ
          </span>
          <a href="http://dendend12345.com/help/" class="btn-more shrink-0">
            <span>MORE</span>
            <svg class="btn-more-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>

        <ul class="space-y-3">
          {helpPosts
            .slice(0, 2)
            .sort((a, b) => b.data.helpPubDate.getTime() - a.data.helpPubDate.getTime())
            .map(post => (
              <ListItemCard
                basePath="help"
                slug={post.slug}
                title={post.data.title}
                pubDate={post.data.helpPubDate}
              />
            ))}
        </ul>
      </div>
    </div>

    <br>

    <div class="request-introduce text-center text-2xl font-bold">
      現在有償にて様々なご依頼を受け付け中！<br>
      でんでんと一緒にいろんなものを作っていこう🐌
    </div>

    <br>

    <!-- タブの開始 -->
    <div class="tab-title tab-4 grid grid-cols-1 md:grid-cols-4 gap-2 md:gap-4 max-width">

      <!-- CREATE -->
      <label>
        <input type="radio" name="tab-4" checked>
        <span class="text-2xl tab-title">CREATE</span>
      </label>

      <div class="text-center">
        <span class="text-2xl md:text-2xl font-bold tab-content">
          動画編集、サムネイル作成、ロゴデザイン、HPなどなど…各種デザインの制作を承ります！
        </span>

        <!-- 2列 -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">

          <!-- 動画編集 -->
          <div class="bg-green-900/60 border border-emerald-500/30 rounded-xl p-6 shadow-lg transition-all text-center text-center">
            <div class="mb-3">
              <h3 class="text-2xl font-bold text-white-900">動画編集</h3>
            </div>
            <p class="text-2xl font-bold text-white mb-3">
              1本 2,500円～
            </p>
            <p class="content-explanation text-1xl font-bold text-white mb-3">
              ショート動画や投稿用動画、切り抜きなどに！
            </p>
            <ul class="text-sm text-gray-300 space-y-1 bg-black/20 p-3 rounded-lg border border-emerald-900/50 text-left">
              <li>・テロップ入れ、SE・BGMの挿入など</li>
              <li>・（例）ショート動画：1本 2,500円〜 / 横動画：1本 5,000円〜</li>
              <li>・修正2回まで（大幅な改修は別途料金を頂くことがあります）</li>
            </ul>
          </div>
            
          <!-- サムネイル作成 -->
          <div class="bg-green-900/60 border border-emerald-500/30 rounded-xl p-6 shadow-lg transition-all text-center">
            <div class="mb-3">
              <h3 class="text-2xl font-bold text-white-900">
                サムネイル作成
              </h3>
            </div>
            <p class="text-2xl font-bold text-white mb-3">
              1枚 1,000円～
            </p>
            <p class="content-explanation text-1xl font-bold text-white mb-3">
              投稿用動画のサムネイルや広報用チラシ、広告バナーなどに！
            </p>
            <ul class="text-sm text-gray-300 space-y-1 bg-black/20 p-3 rounded-lg border border-emerald-900/50 text-left">
              <li>・素材取得に時間がかかる場合は追加料金を頂きます</li>
              <li>・修正は2回まで（大幅な改修は別途料金を頂くことがあります）</li>
            </ul>
          </div>

          <!-- ロゴデザイン -->
          <div class="bg-green-900/60 border border-emerald-500/30 rounded-xl p-6 shadow-lg transition-all text-center">
            <div class="mb-3">
              <h3 class="text-2xl font-bold text-white-900">ロゴデザイン</h3>
            </div>
            <p class="text-2xl font-bold text-white mb-3">
              1個 15,000円～
            </p>
            <p class="content-explanation text-1xl font-bold text-white mb-3">
              活動、イベントや企業用ロゴに！
            </p>
            <ul class="text-sm text-gray-300 space-y-1 bg-black/20 p-3 rounded-lg border border-emerald-900/50 text-left">
              <li>・デザイン料別</li>
              <li>・修正2回まで（大幅な改修は別途料金を頂くことがあります）</li>
            </ul>
          </div>

          <!-- HP -->
          <div class="bg-green-900/60 border border-emerald-500/30 rounded-xl p-6 shadow-lg transition-all text-center">
            <div class="mb-3">
              <h3 class="text-2xl font-bold text-white-900">HP</h3>
            </div>
            <p class="text-2xl font-bold text-white mb-3">
              1サイト 30,000円～
            </p>
            <p class="content-explanation text-1xl font-bold text-white mb-3">
              公式HPやポートフォリオ、ブログなどの運用に！
            </p>
            <ul class="text-sm text-gray-300 space-y-1 bg-black/20 p-3 rounded-lg border border-emerald-900/50 text-left">
              <li>・デザイン料別</li>
              <li>・保守料別</li>
              <li>・サーバー / ドメイン料別</li>
              <li>・修正1回まで（大幅な改修は別途料金を頂くことがあります）</li>
            </ul>
          </div>

        </div>
      </div>

      <!-- SERVER -->
      <label>
        <input type="radio" name="tab-4">
        <span class="text-2xl tab-title">SERVER</span>
      </label>

      <div class="text-center">
        <span class="text-2xl md:text-2xl font-bold tab-content">
          各種ゲームサーバー構築運用を承ります！
        </span>

        <!-- 2列 -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">

          <!-- サーバーレンタル -->
          <div class="bg-green-900/60 border border-emerald-500/30 rounded-xl p-6 shadow-lg transition-all text-center">
            <div class="mb-3">
              <h3 class="text-2xl font-bold text-white-900">サーバーレンタル</h3>
            </div>
            <p class="text-2xl font-bold text-white mb-3">
              1カ月 1,000円～
            </p>
            <p class="content-explanation text-1xl font-bold text-white mb-3 ">
              配信活動や友達と遊びたい方へ！
            </p>
            <ul class="text-sm text-gray-300 space-y-1 bg-black/20 p-3 rounded-lg border border-emerald-900/50 text-left">
              <li>・（例）2G：1,000円〜 / 8G：3,500円〜</li>
              <li>・Ubuntuへのアクセス権限はございません（サーバー構築 / 運用とセットがデフォルトになります）</li>
            </ul>
          </div>
            
          <!-- サーバー -->
          <div class="bg-green-900/60 border border-emerald-500/30 rounded-xl p-6 shadow-lg transition-all text-center">
            <div class="mb-3">
              <h3 class="text-2xl font-bold text-white-900">サーバー構築 / 運用</h3>
            </div>
            <p class="text-2xl font-bold text-white mb-3">
              1カ月 2,500円～
            </p>
            <p class="content-explanation text-1xl font-bold text-white mb-3 ">
              煩わしい設定や軽量化はお任せ！
            </p>
            <ul class="text-sm text-gray-300 space-y-1 bg-black/20 p-3 rounded-lg border border-emerald-900/50 text-left">
              <li>・Minecraft / ARK / 7dtd / Rustなど</li>
              <li>・データパック / プラグイン / MOD導入は別料金</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- DEV -->
      <label>
        <input type="radio" name="tab-4">
        <span class="text-2xl tab-title">DEV</span>
      </label>

      <div class="text-center">
        <span class="text-2xl md:text-2xl font-bold tab-content">
          各種ツールやMinecraftのゲーム / ツール作成いたします！
        </span>

        <!-- 2列 -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">

          <!-- Minecraft -->
          <div class="bg-green-900/60 border border-emerald-500/30 rounded-xl p-6 shadow-lg transition-all text-center">
            <div class="mb-3">
              <h3 class="text-2xl font-bold text-white-900">Minecraft開発</h3>
            </div>
            <p class="text-2xl font-bold text-white mb-3">
              1個 15,000円～
            </p>
            <p class="content-explanation text-1xl font-bold text-white mb-3 ">
              オリジナルゲーム制作に！
            </p>
            <ul class="text-sm text-gray-300 space-y-1 bg-black/20 p-3 rounded-lg border border-emerald-900/50 text-left">
              <li>・データパック、プラグインを用いた開発</li>
              <li>・ウォーターフォール、アジャイルどちらも承ります</li>
            </ul>
          </div>
            
          <!-- ツール作成 -->
          <div class="bg-green-900/60 border border-emerald-500/30 rounded-xl p-6 shadow-lg transition-all text-center">
            <div class="mb-3">
              <h3 class="text-2xl font-bold text-white-900">ツール作成</h3>
            </div>
            <p class="text-2xl font-bold text-white mb-3">
              1個 30,000円～
            </p>
            <p class="content-explanation text-1xl font-bold text-white mb-3 ">
              業務効率化やDX化に！
            </p>
            <ul class="text-sm text-gray-300 space-y-1 bg-black/20 p-3 rounded-lg border border-emerald-900/50 text-left">
              <li>・GASやVBA、Pythonを用いた開発</li>
              <li>・ウォーターフォール、アジャイルどちらも承ります</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- HELP -->
      <label>
        <input type="radio" name="tab-4">
        <span class="text-2xl tab-title">HELP</span>
      </label>

      <div class="text-center">
        <span class="text-2xl md:text-2xl font-bold tab-content">
          いろいろなお困りごとを解決します！
        </span>

        <div class="grid grid-cols-1 md:grid-cols-1 gap-6 mt-6">

          <!-- お困りごと解決 -->
          <div class="bg-green-900/60 border border-emerald-500/30 rounded-xl p-6 shadow-lg transition-all text-center">
            <div class="mb-3">
              <h3 class="text-2xl font-bold text-white-900">ヘルプデスク</h3>
            </div>
            <p class="text-2xl font-bold text-white mb-3">
              1トラブル 2,000円
            </p>
            <p class="content-explanation text-1xl font-bold text-white mb-3 ">
              ITの「わからない」「困った」を解決。サーバーの建て方やシステム導入に！
            </p>
            <ul class="text-sm text-gray-300 space-y-1 bg-black/20 p-3 rounded-lg border border-emerald-900/50 text-left">
              <li>・プログラムのエラーや、サーバー構築、MOD導入などのトラブル解決</li>
              <li>・解決できた場合のみ、お代金をいただきます</li>
            </ul>
          </div>

        </div>
      </div>

    </div>

    <p class="free-consultation flex justify-center text-4xl">
      ✨ご相談は無料です✨
    </p>

    <p class="contact flex justify-center text-2xl">
      連絡先
    </p>
    <p class="contact-url flex justify-center text-2xl">
      X：
      <a href="https://x.com/dendend12345" class=" flex justify-center text-2xl">
        https://x.com/dendend12345
      </a>
    </p>
  
    <p class="contact-url flex justify-center text-2xl">
      MAIL：
      <a href="2dendenden2@gmail.com" class=" flex justify-center text-2xl">
        2dendenden2@gmail.com
      </a>
    </p>

    <br>

    <style is:global>

      @import url('https://fonts.googleapis.com/earlyaccess/notosansjapanese.css');

      .image-container {
        position: relative;
        width: 100%;
        max-width: 1000px;
        margin: 0 auto;
        top: -100px;
      }
        
      .logo-img {
        width: 100%;
        height: auto;
        display: block;
      }

      .animation-denden-logo {
        position: absolute;
        bottom: -25%;
        left: 10%;
        width: 35%;
        z-index: 2;
        animation: slideIn 0.8s ease forwards;
      }

      @keyframes slideIn {
        from {
          opacity: 0;
          transform: translateX(50px);
        } 
        to {
          opacity: 1;
          transform: translateX(0);
        }
      }

      .official-site-text {
        position: absolute;
        bottom: -5%;
        right: -2%;
        font-family: "Noto Sans Japanese", sans-serif;
        font-weight: 800;
        font-size: 3.2vw;
        color: #FFFFFF;
        z-index: 3;
        white-space: nowrap;
      }

      .official-site-text  {
        animation: bounceIn 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
      }

      @keyframes bounceIn {
        0% {
          transform: scale(0);
          opacity: 0;
        }
        60% {
          transform: scale(1.1);
          opacity: 1;
        }
        100% {
          transform: scale(1);
          opacity: 1;
        }
      }

      .btn-more {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.25rem 0.75rem;
        font-size: 1.25em;
        font-weight: 600;
        color: #4ade80;
        background-color: #171717;
        border: 1px solid rgba(64, 64, 64, 0.6);
        border-radius: 9999px;
        transition: all 0.2s ease;
        text-decoration: none;
      }

      .btn-more:hover {
        background-color: #262626;
        border-color: #4ade80;
        box-shadow: 0 0 10px rgba(74, 222, 128, 0.2);
      }

      .btn-more:hover .btn-more-icon {
        transform: translateX(2px);
      }

      .btn-more-icon {
        width: 0.875rem;
        height: 0.875rem;
        transition: transform 0.2s ease;
      }

      .text-3xl {
        font-size: 1rem;
      }

      .link{
        font-size: 1rem;
      }

      .tab-4 {
          display: flex;
          flex-wrap: wrap;
          max-width: 1920px;
      }

      .tab-4 > label {
          flex: 1 1;
          order: -1;
          position: relative;
          min-width: 70px;
          padding: .7em 1em;
          color: #999;
                  font-weight: 600;
          font-size: .9em;
          text-align: center;
          cursor: pointer;
      }

      .tab-4 > label:hover,
      .tab-4 label:has(:checked) {
          background-color: #14532d99;
          color: #fff;
      }

      .tab-4 label:has(:checked)::before {
          position: absolute;
          bottom: -8px;
          left: 50%;
          transform: translateX(-50%);
          width: 18px;
          height: 9px;
          background-color: #14532d99;
          content: '';
          clip-path: polygon(0 0, 100% 0, 50% 100%);
      }

      .tab-4 input {
          display: none;
      }

      .tab-4 > div {
          display: none;
          width: 100%;
          padding: 1.5em 1em;
      }

      .tab-4 label:has(:checked) + div {
          display: block;
      }

      @media (max-width: 768px) {

        .text-5xl {
          font-size: 0.725rem;
          margin-top: 50px;
          margin-bottom: 30px;
          line-height: 1.6;
          }

        .image-container{
          width: 100%;
          max-width: 100%;
          margin: 0 auto 20px auto; 
          top: -25px;
        }

        .official-site-text {
          font-size: 4.5vw;
          right: 2%;
          bottom: -5%;
        }

        .request-introduce{
          font-size: 1rem;
          line-height: 150%;
        }

        .tab-title{
          font-size: 0.85rem;
        }

        .tab-content{
          font-size: 1rem;
          line-height: 50%; 
        }

        .content-explanation{
          line-height: 150%;
        }

        .free-consultation{
          font-size: 1.5rem;
        }

        .contact{
          font-size: 1.25rem;
        }

        .contact-url{
          font-size: 1.25rem;
        }
      }
    </style>
    <Footer />
  </body>

</MainLayout>