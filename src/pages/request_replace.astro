---
import MainLayout from '../layouts/MainLayout.astro';
import { ViewTransitions } from 'astro:transitions';
---
<MainLayout title="でんでんの飼育小屋">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <ViewTransitions />
  </head>
  <div class="text-3xl font-bold tracking-tight text-white-900">
    みんなの情シス
  </div>

  <img src="/images/denden_trans.png" alt="でんでん" class="animation_trans_logo" style="width:1000px; float:right;" />
  
<style>
  /* アニメーションの動きを定義 */
  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateX(50px);
    } 
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
  .animation_trans_logo {
    /* 定義したアニメーションを適用（0.8秒、smoothに） */
    animation: slideIn 0.8s ease forwards;
  }
</style>

</MainLayout>