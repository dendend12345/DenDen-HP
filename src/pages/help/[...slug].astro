---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content'; 
import MainLayout from '../../layouts/MainLayout.astro';

export async function getStaticPaths() {
  const helpEntries = await getCollection('help', ({ data }) => {
    // 開発環境(import.meta.env.DEV)ならdraftも含め、本番環境(PROD)ならdraft以外を取得する
    return import.meta.env.DEV || !data.draft;
  });

  return helpEntries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'help'>;
}
const { entry } = Astro.props;
const { Content } = await entry.render();
---

<MainLayout title={entry.data.title}>
  <article class="prose prose-invert text-[#d1ffd1] prose-p:text-[#d1ffd1] prose-headings:text-[#d1ffd1] prose-a:text-[#4ade80] mx-auto">
    <h1>{entry.data.title}</h1>
    <p>公開日: {entry.data.helpPubDate.toLocaleDateString('ja-JP')}</p>
    <hr/>
    <Content/> 
  </article>
</MainLayout>

<style>
  article {
    max-width: 800px;
    margin: 0 auto;
    line-height: 1.6;
  }
</style>
