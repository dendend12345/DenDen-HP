---
interface Props {
  basePath: string;
  slug: string;
  title: string;
  pubDate: Date;
  suffix?: string;
}

const { basePath, slug, title, pubDate, suffix } = Astro.props;

// JST (+9時間) フォーマット処理
const formattedDate = new Date(pubDate.getTime() + 9 * 60 * 60 * 1000)
  .toISOString()
  .slice(0, 10)
  .replace(/-/g, '/');
---

<li class="list-none w-full">
  <div class="w-full rounded-md bg-green-900/60 border border-green-800/80 transition-all duration-200 ease-out hover:bg-green-900 hover:border-green-500/50 hover:scale-[1.01]">
    <a 
      href={`/${basePath}/${slug}`}
      class="flex flex-col items-start p-2 h-full text-green-400 no-underline"
    >
      <span class="wshrink-0 text-[11px] font-mono text-neutral-400 bg-neutral-800/80 px-2 py-0.5 rounded border border-neutral-700/50">
        {formattedDate}{suffix ? ` ${suffix}` : ''}
      </span>
      <span class="text-base font-medium break-words">{title}</span>
    </a>
  </div>
</li>

<style is:global>
  @media (max-width: 600px) {
    .flex{
      font-size: 75%;
    }
  }
</style>