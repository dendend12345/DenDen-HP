---
const { title } = Astro.props;
---
<html lang="ja">
  <head>
    <!-- <img src="/images/denden_header1.png" alt="denden_header" width="25%" style="margin: 0 auto;" /> -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-KYDDTTTL2K" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
    
      gtag('config', 'G-KYDDTTTL2K');
    </script>

    <meta charset="utf-8" />
    <title>{title}</title>
    <style is:global>
      body {
        background-color: #0a1a0a;
        color: #d1ffd1;
        font-family: 'Helvetica Neue', Arial, sans-serif;
        margin: 0;
        padding: 2rem;;
      }
      nav { margin-bottom: 2rem; border-bottom: 1px solid #2d5a27; padding-bottom: 1rem; }
      a { color: #4ade80; text-decoration: none; margin-right: 2rem; font-size: 1rem; }
    </style>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  </head>
  <body>
    <nav class="nav">
      <a href="/">HOME</a>
      <a href="/about">ABOUT</a>
      <a href="/work">WORK</a>
      <a href="/request">REQUEST</a>
      <a href="/blog">BLOG</a>
      <a href="/help">HELP</a>
      <a href="/product">PRODUCT</a>
      <a href="/news">NEWS</a>
    </nav>
    <main>
      <slot /> 
    </main>

    <style is:global>
      @media (max-width: 600px) {
        body nav.nav {
          display: flex;
          flex-wrap: wrap;
          justify-content: space-between;
          align-items: center;
          width: 100%;
          row-gap: 8px;
          padding: 0;
        }

        body nav.nav a {
          width: 10%;
          text-align: center;
          font-size: 0.9rem;
          white-space: nowrap;
          box-sizing: border-box;
        }
      }
    </style>

  </body>
</html>
