---
const { title } = Astro.props;
---
<html lang="ja">
  <head>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-KYDDTTTL2K" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
    
      gtag('config', 'G-KYDDTTTL2K');
    </script>

    <meta charset="utf-8" />
    <title>{title}</title>

    <style is:global>
      body {
        background-color: #0a1a0a;
        color: #d1ffd1;
        font-family: 'Helvetica Neue', Arial, sans-serif;
        margin: 0;
        padding: 2rem;
      }
      nav {
        position: relative;
        z-index: 10;
        margin-bottom: 2rem;
        border-bottom: 1px solid #2d5a27;
        padding-bottom: 1rem;
      }
      a {
        color: #4ade80;
        text-decoration: none;
        margin-right: 2rem;
        font-size: 1.5rem;
      }
    </style>

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  </head>

  <body>
    <nav class="nav">
      <a href="/">HOME</a>
      <a href="/about">ABOUT</a>
      <a href="/work">WORK</a>
      <a href="/request">REQUEST</a>
      <a href="/blog">BLOG</a>
      <a href="/help">HELP</a>
      <a href="/product">PRODUCT</a>
      <a href="/news">NEWS</a>
    </nav>
    <main>
      <slot /> 
    </main>

    <style is:global>

    @media (max-width: 600px) {
      body {
        padding: 1rem;
      }

      body nav.nav {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        width: 100%;
        max-width: 320px;
        gap: 12px 6px;
        padding: 10px 0 16px 0 !important; 
        margin: 0 auto 2.5rem auto !important; 
        
        box-sizing: border-box;
      }

      body nav.nav a {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        font-size: 0.75rem;
        line-height: 1.4;
        padding: 2px 0;
        margin-right: 0 !important;
        white-space: nowrap;
        box-sizing: border-box;
      }
    }

    </style>

  </body>
</html>